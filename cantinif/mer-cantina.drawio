  <diagram id="02_-_Regras_e_premissas" name="02 - Regras e premissas">
    <mxGraphModel dx="1820" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1300" background="#F7F9FC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v73" value="Regras e premissas do modelo" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#172B4D;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1700" height="55" />
        </mxCell>
        <mxCell id="v74" value="As escolhas abaixo completam os dados implícitos no processo. Não são requisitos adicionais aprovados." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#52657C;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="99" width="1700" height="35" />
        </mxCell>
        <mxCell id="v75" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD7E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="175" width="830" height="320" />
        </mxCell>
        <mxCell id="v76" value="1. Participantes e responsabilidades" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#174C78;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="188" width="790" height="35" />
        </mxCell>
        <mxCell id="v77" value="• ALUNO realiza zero ou vários pedidos; cada pedido pertence a um aluno." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="235" width="790" height="30" />
        </mxCell>
        <mxCell id="v78" value="• FUNCIONÁRIO representa atendentes e cozinheiros; a função restringe ATENDE e&#xa;PREPARA." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="265" width="790" height="50" />
        </mxCell>
        <mxCell id="v79" value="• Um pedido pode ainda não ter atendente ou cozinheiro. Quando atribuído, considera-se&#xa;um responsável por função." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="315" width="790" height="50" />
        </mxCell>
        <mxCell id="v80" value="• Se houver vários responsáveis por pedido, essas duas cardinalidades devem ser&#xa;ampliadas." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="365" width="790" height="50" />
        </mxCell>
        <mxCell id="v81" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD7E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="175" width="830" height="320" />
        </mxCell>
        <mxCell id="v82" value="2. Pedido e seus itens" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#174C78;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="188" width="790" height="35" />
        </mxCell>
        <mxCell id="v83" value="• Cada pedido contém um ou vários produtos. Um produto pode constar de vários pedidos." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="235" width="790" height="30" />
        </mxCell>
        <mxCell id="v84" value="• CONTÉM é N:N e possui quantidade e preço unitário praticado, preservado mesmo se o&#xa;cardápio mudar." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="265" width="790" height="50" />
        </mxCell>
        <mxCell id="v85" value="• Quantidade é positiva; preços são não negativos. Produtos repetidos são agrupados&#xa;por pedido." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="315" width="790" height="50" />
        </mxCell>
        <mxCell id="v86" value="• Na conversão ao modelo lógico, CONTÉM origina ITEM_PEDIDO (pedido, produto,&#xa;quantidade, preço unitário)." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="365" width="790" height="50" />
        </mxCell>
        <mxCell id="v87" value="• Total do pedido é derivado da soma dos itens; não há subtotais ou totais duplicados&#xa;no modelo conceitual." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="415" width="790" height="50" />
        </mxCell>
        <mxCell id="v88" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD7E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="520" width="830" height="320" />
        </mxCell>
        <mxCell id="v89" value="3. Cobrança e pagamento PIX" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#174C78;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="533" width="790" height="35" />
        </mxCell>
        <mxCell id="v90" value="• Um pedido possui zero ou um pagamento; todo pagamento pertence a exatamente um&#xa;pedido." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="580" width="790" height="50" />
        </mxCell>
        <mxCell id="v91" value="• A cobrança só existe após a conferência de disponibilidade. Pedido indisponível pode&#xa;não ter pagamento." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="630" width="790" height="50" />
        </mxCell>
        <mxCell id="v92" value="• Status do pagamento: pendente, confirmado ou falhou. Confirmado exige data de&#xa;confirmação." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="680" width="790" height="50" />
        </mxCell>
        <mxCell id="v93" value="• Valor corresponde ao total cobrado; referencia_pix identifica a cobrança de forma&#xa;única." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="730" width="790" height="50" />
        </mxCell>
        <mxCell id="v94" value="• Uma tentativa por pedido segue o BPMN, que cancela após falha. Repetição de&#xa;tentativas exigiria 0:N." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="780" width="790" height="50" />
        </mxCell>
        <mxCell id="v95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD7E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="520" width="830" height="320" />
        </mxCell>
        <mxCell id="v96" value="4. Estados, preparo e retirada" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#174C78;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="533" width="790" height="35" />
        </mxCell>
        <mxCell id="v97" value="• Status sugeridos do pedido: recebido, aguardando_pagamento, em_preparo, pronto,&#xa;entregue e cancelado." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="580" width="790" height="50" />
        </mxCell>
        <mxCell id="v98" value="• Preparo é permitido somente após pagamento confirmado; a retirada exige pedido&#xa;pronto." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="630" width="790" height="50" />
        </mxCell>
        <mxCell id="v99" value="• Cancelamento registra o motivo: itens_indisponiveis ou pagamento_falhou." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="680" width="790" height="30" />
        </mxCell>
        <mxCell id="v100" value="• senha_retirada é o código de chamada no balcão; é único entre pedidos ainda&#xa;aguardando retirada." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="710" width="790" height="50" />
        </mxCell>
        <mxCell id="v101" value="• retirado_em é preenchido ao concluir a entrega; não há entrega para pedido&#xa;cancelado." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="760" width="790" height="50" />
        </mxCell>
        <mxCell id="v102" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD7E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="865" width="830" height="320" />
        </mxCell>
        <mxCell id="v103" value="5. Escopo enxuto" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#174C78;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="878" width="790" height="35" />
        </mxCell>
        <mxCell id="v104" value="• O cardápio é a apresentação dos produtos disponíveis. Não exige entidade própria&#xa;neste fluxo." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="925" width="790" height="50" />
        </mxCell>
        <mxCell id="v105" value="• A disponibilidade é um indicador de produto; estoque, ingredientes e reservas não&#xa;são detalhados no BPMN." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="975" width="790" height="50" />
        </mxCell>
        <mxCell id="v106" value="• Avisos e chamada são ações do processo. Não foram transformados em entidades de&#xa;notificação." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1025" width="790" height="50" />
        </mxCell>
        <mxCell id="v107" value="• Considera-se uma cantina e pagamento por PIX; não há múltiplas unidades, entrega&#xa;externa ou reembolso." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1075" width="790" height="50" />
        </mxCell>
        <mxCell id="v108" value="• Identificadores e datas são atributos propostos para permitir rastreabilidade." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1125" width="790" height="30" />
        </mxCell>
        <mxCell id="v109" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD7E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="865" width="830" height="320" />
        </mxCell>
        <mxCell id="v110" value="6. Do BPMN ao M.E.R." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#174C78;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="878" width="790" height="35" />
        </mxCell>
        <mxCell id="v111" value="• Escolher lanche → PRODUTO e CONTÉM." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="925" width="790" height="30" />
        </mxCell>
        <mxCell id="v112" value="• Enviar pedido → ALUNO, REALIZA e PEDIDO." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="955" width="790" height="30" />
        </mxCell>
        <mxCell id="v113" value="• Conferir itens / cancelar → ATENDE, disponibilidade e motivo de cancelamento." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="985" width="790" height="30" />
        </mxCell>
        <mxCell id="v114" value="• Cobrar / confirmar PIX → PAGAMENTO e POSSUI." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1015" width="790" height="30" />
        </mxCell>
        <mxCell id="v115" value="• Preparar lanche → PREPARA e status do pedido." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1045" width="790" height="30" />
        </mxCell>
        <mxCell id="v116" value="• Chamar pela senha / retirar → senha_retirada, retirado_em e status entregue." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1075" width="790" height="30" />
        </mxCell>
        <mxCell id="v117" value="• Fonte única: arquivo “diagrama bpmn.drawio” fornecido pelo usuário." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1105" width="790" height="30" />
        </mxCell>
        <mxCell id="v118" value="Modelo conceitual: relacionamentos são mostrados explicitamente; chaves estrangeiras e tipos SQL pertencem à etapa lógica/física." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#52657C;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1240" width="1700" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
